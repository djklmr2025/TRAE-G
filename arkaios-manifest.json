{
  "name": "Arkaios Sovereign Lab",
  "version": "1.0.0",
  "defaultInstallDir": "%USERPROFILE%\\ArkaiosLab",
  "repos": [
    {
      "id": "trae-g",
      "name": "TRAE-G Arkaios Local Lab",
      "url": "https://github.com/djklmr2025/TRAE-G.git",
      "path": "TRAE-G",
      "required": true,
      "runtime": "node",
      "install": "npm install",
      "build": "npm run build"
    },
    {
      "id": "agent-core",
      "name": "Arkaios Agent Core",
      "url": "https://github.com/djklmr2025/Arkaios-AI-Provider.git",
      "path": "Arkaios-Agent-Core",
      "required": false,
      "runtime": "node"
    },
    {
      "id": "service-api",
      "name": "Servidor Arkaios API",
      "url": "https://github.com/djklmr2025/Servidor_Arkaios_API.git",
      "path": "Servidor_Arkaios_API",
      "required": false,
      "runtime": "node"
    },
    {
      "id": "dj-nexus",
      "name": "Arkaios DJ Nexus",
      "url": "https://github.com/djklmr2025/Arkaios-DJ-Nexus.git",
      "path": "Arkaios-DJ-Nexus",
      "required": false,
      "runtime": "dotnet"
    },
    {
      "id": "agent-bridge-local",
      "name": "Arkaios Agent Bridge Local Messenger",
      "url": "local:C:\\ARKAIOS\\agent-bridge",
      "path": "agent-bridge",
      "required": false,
      "runtime": "python",
      "bootstrap": "bridge-bootstrap.ps1",
      "notes": "Canal local auditable para mensajes directos y salas council entre agentes."
    },
    {
      "id": "puter-internet-os-local",
      "name": "Puter Internet OS Local",
      "url": "local:C:\\ARKAIOS\\puter-internetOS",
      "path": "puter-internetOS",
      "required": false,
      "runtime": "node",
      "bootstrap": "neural-puter-bootstrap.ps1",
      "notes": "Capa visual/OS web opcional. Arranque esperado por npm start en http://puter.localhost:4100."
    },
    {
      "id": "arkaios-virtual-body-local",
      "name": "ARKAIOS Virtual Body Local",
      "url": "local:C:\\ARKAIOS\\Agente Autonomo MVP\\arkaios_virtual_body_v1",
      "path": "arkaios_virtual_body_v1",
      "required": false,
      "runtime": "python",
      "bootstrap": "neural-puter-bootstrap.ps1",
      "notes": "API local segura en 127.0.0.1:8787 para pantalla, voz, archivos workspace y acciones confirmadas."
    },
    {
      "id": "neuralagent-ai-local",
      "name": "NeuralAgent AI Local",
      "url": "local:C:\\ARKAIOS\\arkaios-neural-agent-main",
      "path": "arkaios-neural-agent-main",
      "required": false,
      "runtime": "python+electron",
      "bootstrap": "neural-puter-bootstrap.ps1",
      "notes": "NeuralAgent real: backend FastAPI en 127.0.0.1:8000, local bridge, eyes/hands y desktop Electron."
    },
    {
      "id": "neuralagent-ai-empty-legacy",
      "name": "NeuralAgent AI Legacy Empty Folder",
      "url": "local:C:\\ARKAIOS\\neuralagentAI-main",
      "path": "neuralagentAI-main",
      "required": false,
      "runtime": "none",
      "bootstrap": "neural-puter-bootstrap.ps1",
      "notes": "Carpeta vacia detectada; se conserva solo como referencia legacy/no activa."
    }
  ],
  "localCapabilities": {
    "workspaceFiles": true,
    "powershell": true,
    "wsl": true,
    "termuxAdb": true,
    "git": true,
    "browser": true,
    "desktopControl": "planned",
    "adminMode": "explicit-confirmation-required"
  },
  "codexIntegration": {
    "supportedMode": "official-login-required",
    "notes": "Arkaios puede detectar y lanzar la CLI/extensión oficial si existe, pero no copia tokens ni sesiones privadas."
  }
}
